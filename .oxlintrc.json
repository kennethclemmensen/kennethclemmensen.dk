{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "@stylistic/padding-line-between-statements": ["warn", {
      "blankLine": "always",
      "prev": ["const", "let"],
      "next": "if"
    }],
    "@stylistic/space-before-function-paren": ["warn", {
      "anonymous": "never",
      "named": "never",
      "asyncArrow": "never",
      "catch": "never"
    }],
    "@stylistic/type-annotation-spacing": ["warn", {
      "before": true,
      "after": true,
      "overrides": {
        "colon": {
          "before": false,
          "after": true
        }
      }
    }],
    "prefer-const": "warn",
    "typescript/no-this-alias": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["**/*", "!public/wp-content/themes/kennethclemmensen/ts/**/*.ts"],
  "jsPlugins": [
    "@stylistic/eslint-plugin"
  ]
}